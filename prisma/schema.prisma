generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                  String               @id @default(cuid())
  email               String               @unique
  displayName         String?
  avatar              String?
  passkeyId           String?
  passkeyPub          String?
  tier                Tier                 @default(FREE)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  apiKeys             ApiKey[]
  portfolios          Portfolio[]
  signals             SignalUsage[]
  rouaSignals         Signal[]
  sessions            Session[]
  accounts            Account[]
  exchangeCredentials ExchangeCredential[]
  orders              Order[]
  positions           Position[]
  trades              Trade[]
  tradingBots         TradingBot[]
  chartPreferences    ChartPreference[]
}

enum Tier {
  FREE
  PREMIUM
  INSTITUTIONAL
}

model ApiKey {
  id              String    @id @default(cuid())
  userId          String
  exchange        String
  encryptedKey    String
  encryptedSecret String
  permissions     String
  iv              String
  isActive        Boolean   @default(true)
  lastValidated   DateTime?
  createdAt       DateTime  @default(now())
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Portfolio {
  id          String           @id @default(cuid())
  userId      String
  name        String
  description String?
  totalValue  Float            @default(0)
  currency    String           @default("USD")
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  assets      PortfolioAsset[]

  @@index([userId])
}

model PortfolioAsset {
  id           String      @id @default(cuid())
  portfolioId  String
  symbol       String
  name         String
  quantity     Float
  avgPrice     Float
  currentPrice Float?
  exchange     String?
  assetType    AssetType
  addedAt      DateTime    @default(now())
  portfolio    Portfolio   @relation(fields: [portfolioId], references: [id], onDelete: Cascade)
}

enum AssetType {
  STOCK
  FOREX
  CRYPTO
  COMMODITY
  INDEX
}

// ── Signal System (Phase 4) ──
enum SignalAction {
  BUY
  SELL
  WAIT
}

enum SignalStatus {
  ACTIVE
  EXPIRED
  EXECUTED
  CANCELLED
}

model Signal {
  id          String       @id @default(cuid())
  userId      String
  pair        String
  action      SignalAction
  confidence  Int
  reason      String
  entryPrice  Float?
  stopLoss    Float?
  takeProfit  Float?
  status      SignalStatus @default(ACTIVE)
  expiresAt   DateTime
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([pair])
  @@index([status])
  @@index([expiresAt])
}

model SignalUsage {
  id         String   @id @default(cuid())
  userId     String
  signalType String
  asset      String
  confidence Float
  analysis   String
  signedHash String?
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  resource  String
  details   String?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([action])
  @@index([createdAt])
}

// ── News Article for RAG (Phase 4) ──
model NewsArticle {
  id              String   @id @default(cuid())
  source          String
  title           String   // Original title (source language)
  translatedTitle String?  // Arabic translation
  content         String   // Original content/description
  translatedContent String? // Arabic translation of content
  summary         String?  // AI-generated summary in Arabic
  url             String?
  sentiment       Float?   // -1.0 (very negative) to 1.0 (very positive)
  sentimentLabel  String?  // "positive", "negative", "neutral"
  impactLevel     String?  // "high", "medium", "low"
  affectedAssets  String?  // JSON array of affected symbols: ["BTC", "ETH"]
  entities        String?  // JSON: named entities extracted
  aiAnalysis      String?  // Full AI analysis from 6 models (JSON)
  category        String?  // News category: Crypto, Forex, Economy, etc.
  categoryAr      String?  // Arabic category name
  embedding       String?  // JSON-encoded 384-dim vector (upgrade to pgvector for Postgres)
  imageUrl        String?  // Optional article image
  publishedAt     DateTime
  fetchedAt       DateTime @default(now())
  createdAt       DateTime @default(now())

  @@index([source])
  @@index([publishedAt])
  @@index([sentimentLabel])
  @@index([category])
}

// ── Exchange Credential model (encrypted API keys) ──
model ExchangeCredential {
  id               String    @id @default(cuid())
  userId           String
  exchange         String
  label            String
  encryptedApiKey  String
  encryptedSecret  String
  iv               String
  authTag          String
  permissions      String    @default("read")
  isValid          Boolean   @default(true)
  lastValidatedAt  DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([exchange])
}

// ── Trading Engine (Phase 5) ──

enum OrderSide {
  BUY
  SELL
}

enum OrderType {
  MARKET
  LIMIT
}

enum OrderStatus {
  PENDING
  ACCEPTED
  PARTIALLY_FILLED
  FILLED
  CANCELLED
  REJECTED
}

enum OrderEventType {
  CREATED
  ACCEPTED
  RISK_REJECTED
  SENT_TO_EXCHANGE
  FILLED
  CANCELLED
}

enum PositionStatus {
  OPEN
  CLOSED
  LIQUIDATED
}

enum TradeType {
  ENTRY
  EXIT
  PARTIAL_EXIT
}

model Order {
  id                  String      @id @default(uuid())
  userId              String
  exchangeCredentialId String
  exchange            String
  symbol              String
  side                OrderSide
  type                OrderType
  quantity            Decimal
  price               Decimal?
  stopLoss            Decimal?
  takeProfit          Decimal?
  status              OrderStatus @default(PENDING)
  filledQuantity      Decimal     @default(0)
  averagePrice        Decimal?
  fee                 Decimal?
  feeCurrency         String?
  exchangeOrderId     String?
  rejectReason        String?
  signalId            String?
  idempotencyKey      String      @unique
  clientOrderId       String?
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt
  user                User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  events              OrderEvent[]

  @@index([userId])
  @@index([symbol])
  @@index([status])
  @@index([exchange])
  @@index([createdAt])
}

model OrderEvent {
  id        String         @id @default(uuid())
  orderId   String
  eventType OrderEventType
  payload   String?
  timestamp DateTime       @default(now())
  order     Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([eventType])
  @@index([timestamp])
}

model Position {
  id             String         @id @default(cuid())
  userId         String
  credentialId   String
  exchange       String
  symbol         String
  side           OrderSide
  status         PositionStatus @default(OPEN)
  quantity       Float
  entryPrice     Float
  currentPrice   Float?
  unrealizedPnl  Float?
  realizedPnl    Float?
  stopLoss       Float?
  takeProfit     Float?
  highestPrice   Float?
  lowestPrice    Float?
  openedAt       DateTime       @default(now())
  closedAt       DateTime?
  updatedAt      DateTime       @updatedAt
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([symbol])
  @@index([status])
  @@index([exchange])
}

model Trade {
  id              String    @id @default(cuid())
  userId          String
  orderId         String?
  positionId      String?
  exchange        String
  symbol          String
  side            OrderSide
  type            TradeType
  quantity        Float
  price           Float
  fee             Float?
  feeCurrency     String?
  pnl             Float?
  exchangeTradeId String?
  executedAt      DateTime  @default(now())
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([symbol])
  @@index([positionId])
  @@index([executedAt])
}

// ── Paper Trading Orders (Execution Engine) ──
model PaperOrder {
  id              String      @id @default(uuid())
  userId          String
  symbol          String
  side            OrderSide
  type            OrderType
  quantity        Decimal
  price           Decimal?
  stopLoss        Decimal?
  takeProfit      Decimal?
  status          OrderStatus @default(PENDING)
  filledQuantity   Decimal     @default(0)
  averagePrice    Decimal?
  fee             Decimal?
  feeCurrency     String?
  slippage        Decimal?
  idempotencyKey  String      @unique
  clientOrderId   String?
  exchangeOrderId String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@index([userId])
  @@index([symbol])
  @@index([status])
  @@index([createdAt])
}

// ── WebAuthn Challenge store ──
model Challenge {
  id        String   @id @default(cuid())
  key       String   @unique
  challenge String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([key])
  @@index([expiresAt])
}

// ── OAuth Account model (NextAuth) ──
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

// ── Strategy Reports ──
model StrategyReport {
  id              String   @id @default(cuid())
  symbol          String
  assetName       String
  title           String
  type            String
  severity        String
  price           Float
  change          Float
  isUp            Boolean
  tag             String?
  decision        String   // JSON stringified { title, color, desc }
  matrix          String   // JSON stringified array of matrices
  risk            String   // JSON stringified risk metrics
  flow            String   // JSON stringified dark pool flows
  consensus       String
  hiddenSignature String
  deepAnalysis    String   // JSON stringified string[]
  publishedAt     DateTime @default(now())
  createdAt       DateTime @default(now())

  @@index([symbol])
  @@index([type])
}

// ── Trading Bot (Automation Engine) ──
model TradingBot {
  id              String   @id @default(cuid())
  userId          String
  name            String   @default("HFT-Alpha")
  strategy        String   @default("Scalp AI")
  isActive        Boolean  @default(false)
  winRate         Float    @default(0)
  totalTrades     Int      @default(0)
  dailyPnl        Float    @default(0)
  statusMessage   String   @default("SYSTEM_IDLE")
  updatedAt       DateTime @updatedAt
  createdAt       DateTime @default(now())
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ── AI Coach Advice ──
model CoachAdvice {
  id                String   @id @default(cuid())
  userId            String
  rating            String   @default("needs_improvement") // excellent, good, needs_improvement
  statisticsSnapshot String  @default("{}") // JSON: win rate, avg win/loss, max DD, etc.
  adviceText        String   // Full advice text from AI
  adviceItems       String   @default("[]") // JSON array of { type, icon, text }
  isRead            Boolean  @default(false)
  createdAt         DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
}

// ── Chart Preferences (Drawings & Settings) ──
model ChartPreference {
  id        String   @id @default(cuid())
  userId    String
  symbol    String   // e.g. "BTC/USD" or "global"
  settings  String   @default("{}") // JSON for colors, indicators, timeframes
  drawings  String   @default("[]") // JSON for lines, rects, fibs, etc.
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, symbol])
  @@index([userId])
  @@index([symbol])
}
