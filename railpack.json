{
  "$schema": "https://railpack.com/config/file/v1",
  "start": "node apps/web/.next/standalone/apps/web/server.js",
  "build": {
    "commands": [
      "bunx prisma generate --schema=./prisma/schema.prisma",
      "bun run build"
    ]
  },
  "install": {
    "commands": ["bun install --frozen-lockfile"]
  }
}
