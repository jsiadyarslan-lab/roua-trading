generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id          String   @id @default(cuid())
  email       String   @unique
  displayName String?
  avatar      String?
  passkeyId   String?
  passkeyPub  String?
  tier        Tier     @default(FREE)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  apiKeys     ApiKey[]
  credentials ExchangeCredential[]
  portfolios  Portfolio[]
  signals     SignalUsage[]
  rouaSignals Signal[]
  sessions    Session[]
}

enum Tier {
  FREE
  PREMIUM
  INSTITUTIONAL
}

model ApiKey {
  id              String    @id @default(cuid())
  userId          String
  exchange        String
  encryptedKey    String
  encryptedSecret String
  permissions     String
  iv              String
  isActive        Boolean   @default(true)
  lastValidated   DateTime?
  createdAt       DateTime  @default(now())
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model ExchangeCredential {
  id              String    @id @default(cuid())
  userId          String
  exchange        String    // e.g., "binance", "kucoin", "bybit"
  label           String    // User-friendly label
  encryptedApiKey String    // AES-256-GCM encrypted
  encryptedSecret String    // AES-256-GCM encrypted
  iv              String    // Initialization vector (hex)
  authTag         String    // GCM authentication tag (hex)
  permissions     String    // JSON: ["read", "trade"] — NEVER "withdraw" or "transfer"
  isValid         Boolean   @default(true)
  lastValidatedAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, exchange, label])
  @@index([userId])
  @@index([exchange])
}

model Portfolio {
  id          String           @id @default(cuid())
  userId      String
  name        String
  description String?
  totalValue  Float            @default(0)
  currency    String           @default("USD")
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  assets      PortfolioAsset[]

  @@index([userId])
}

model PortfolioAsset {
  id           String      @id @default(cuid())
  portfolioId  String
  symbol       String
  name         String
  quantity     Float
  avgPrice     Float
  currentPrice Float?
  exchange     String?
  assetType    AssetType
  addedAt      DateTime    @default(now())
  portfolio    Portfolio   @relation(fields: [portfolioId], references: [id], onDelete: Cascade)
}

enum AssetType {
  STOCK
  FOREX
  CRYPTO
  COMMODITY
  INDEX
}

enum SignalAction {
  BUY
  SELL
  WAIT
}

enum SignalStatus {
  ACTIVE
  EXPIRED
  EXECUTED
  CANCELLED
}

model Signal {
  id          String       @id @default(cuid())
  userId      String
  pair        String       // e.g., "BTC/USDT", "AAPL"
  action      SignalAction
  confidence  Int          // 0-100
  reason      String       // AI-generated explanation
  entryPrice  Float?
  stopLoss    Float?
  takeProfit  Float?
  status      SignalStatus @default(ACTIVE)
  expiresAt   DateTime
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([pair])
  @@index([status])
  @@index([expiresAt])
}

model SignalUsage {
  id         String   @id @default(cuid())
  userId     String
  signalType String
  asset      String
  confidence Float
  analysis   String
  signedHash String?
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  resource  String
  details   String?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([action])
  @@index([createdAt])
}

model NewsArticle {
  id          String   @id @default(cuid())
  source      String
  title       String
  content     String
  summary     String?
  url         String?
  sentiment   Float?
  entities    String?
  embedding   String?
  publishedAt DateTime
  createdAt   DateTime @default(now())

  @@index([source])
  @@index([publishedAt])
}
