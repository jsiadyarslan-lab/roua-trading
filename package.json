{
  "name": "roua-trading",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "start": "node apps/web/.next/standalone/apps/web/server.js",
    "lint": "turbo lint",
    "dev:web": "turbo dev --filter=@roua/web",
    "dev:api": "turbo dev --filter=@roua/api",
    "db:push": "turbo db:push --filter=@roua/web",
    "db:generate": "turbo db:generate --filter=@roua/web"
  },
  "devDependencies": {
    "prisma": "6.19.2",
    "turbo": "^2.5.0",
    "typescript": "^5"
  },
  "packageManager": "bun@1.2.0",
  "dependencies": {
    "@prisma/client": "6.19.2"
  }
}
