# ── قاعدة البيانات (مطلوب) ──
# غيّر المضيف وكلمة المرور حسب إعدادات Railway PostgreSQL
DATABASE_URL=postgresql://postgres:roua_dev_2026@localhost:5432/roua_trading

# ── Redis (مطلوب لحالة الوكيل) ──
# بدون Redis يفقد الوكيل حالته كل دقيقة
REDIS_URL=redis://:roua_redis_2026@localhost:6379

# ── تشفير مفاتيح API (مطلوب للتداول) ──
# بدون هذا المفتاح لا يستطيع الوكيل فك تشفير بيانات الاعتماد
# تم توليده: openssl rand -hex 32
# ⚠️ لا تغيّره بعد حفظه — ستفقد كل المفاتيح المشفرة!
ENCRYPTION_KEY=fbfd190c7c3d04464fd528ffb76f8c447b81622c605f0ad55c3bb53cc3e68daa

# ── المفتاح الرئيسي للتداول الذاتي ──
# 🔴 بدون true لن يعمل الوكيل أبداً!
AUTO_TRADING_ENABLED=true

# ── مصادقة NextAuth (مطلوب) ──
NEXTAUTH_SECRET=HENJXpdW0IZSJ1v15ruVAwvHFfrsws/KSqVJno4aH0Edc+YK6tVzctASuPxrMkKX
