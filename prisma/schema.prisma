generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id          String     @id @default(cuid())
  email       String     @unique
  displayName String?
  avatar      String?
  passkeyId   String?
  passkeyPub  String?
  tier        Tier       @default(FREE)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  apiKeys     ApiKey[]
  portfolios  Portfolio[]
  signals     SignalUsage[]
  sessions    Session[]
  accounts    Account[]
}

enum Tier {
  FREE
  PREMIUM
  INSTITUTIONAL
}

model ApiKey {
  id              String    @id @default(cuid())
  userId          String
  exchange        String
  encryptedKey    String
  encryptedSecret String
  permissions     String
  iv              String
  isActive        Boolean   @default(true)
  lastValidated   DateTime?
  createdAt       DateTime  @default(now())
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Portfolio {
  id          String           @id @default(cuid())
  userId      String
  name        String
  description String?
  totalValue  Float            @default(0)
  currency    String           @default("USD")
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  assets      PortfolioAsset[]

  @@index([userId])
}

model PortfolioAsset {
  id           String      @id @default(cuid())
  portfolioId  String
  symbol       String
  name         String
  quantity     Float
  avgPrice     Float
  currentPrice Float?
  exchange     String?
  assetType    AssetType
  addedAt      DateTime    @default(now())
  portfolio    Portfolio   @relation(fields: [portfolioId], references: [id], onDelete: Cascade)
}

enum AssetType {
  STOCK
  FOREX
  CRYPTO
  COMMODITY
  INDEX
}

model SignalUsage {
  id         String   @id @default(cuid())
  userId     String
  signalType String
  asset      String
  confidence Float
  analysis   String
  signedHash String?
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  resource  String
  details   String?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([action])
  @@index([createdAt])
}

model NewsArticle {
  id          String   @id @default(cuid())
  source      String
  title       String
  content     String
  summary     String?
  url         String?
  sentiment   Float?
  entities    String?
  embedding   String?
  publishedAt DateTime
  createdAt   DateTime @default(now())

  @@index([source])
  @@index([publishedAt])
}

// ── OAuth Account model (NextAuth) ──
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}
