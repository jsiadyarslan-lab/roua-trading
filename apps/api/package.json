    "test:e2e:trading": "jest --config ./test/jest-e2e.json --forceExit test/e2e/trading.e2e-spec.ts",
    "test:e2e:execution": "jest --config ./test/jest-e2e.json --forceExit test/e2e/execution.e2e-spec.ts"
  },
  "dependencies": {
