    "start:prod": "node dist/main",
    "lint": "eslint .",
    "db:generate": "prisma generate --schema=/home/z/my-project/prisma/schema.prisma",
    "db:push": "prisma db push --schema=/home/z/my-project/prisma/schema.prisma",
    "test:e2e": "jest --config ./test/jest-e2e.json --forceExit --detectOpenHandles",
