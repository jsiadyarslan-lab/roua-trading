{
  "$schema": "https://railpack.com/config/file/v1",
  "start": "cd apps/web && HOSTNAME=0.0.0.0 bun x next start -H 0.0.0.0",
  "build": {
    "commands": [
      "bunx prisma generate --schema=./prisma/schema.prisma",
      "bun run build"
    ]
  },
  "install": {
    "commands": ["bun install"]
  }
}
