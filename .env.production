# ╔═══════════════════════════════════════════════╗
# ║  🟠 مهم — إعدادات الوكيل والمخاطر           ║
# ╚═══════════════════════════════════════════════╝

# ── رصيد افتراضي للمتداولين الجدد (ورقي) ──
DEFAULT_PAPER_BALANCE=10000

# ── حدود المخاطر (مستوى الوكيل — أضيق) ──
MAX_POSITION_SIZE_PERCENT=2
MAX_DAILY_LOSS_PERCENT=5
MAX_OPEN_POSITIONS=5

# ── حدود المخاطر (مستوى التداول العام — أوسع) ──
RISK_MAX_POSITION_PERCENT=20
RISK_MAX_OPEN_POSITIONS=10
RISK_MAX_DAILY_LOSS_PERCENT=5
RISK_DEFAULT_STOP_LOSS=3
RISK_DEFAULT_TAKE_PROFIT=6
RISK_MAX_LEVERAGE=3
RISK_MIN_ORDER_SIZE=10
RISK_MAX_ORDER_SIZE=50000
RISK_CIRCUIT_BREAKER_THRESHOLD=10

# ── التداول الورقي (محاكاة) ──
PAPER_SLIPPAGE_PERCENT=0.1
PAPER_COMMISSION_PERCENT=0.1
NEXT_PUBLIC_PAPER_TRADING=false

