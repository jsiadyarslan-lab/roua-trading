# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# Roua Trading — Docker Ignore
# Reduces build context size and prevents leaking secrets
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

# Dependencies (installed fresh inside container)
**/node_modules
**/.prisma
**/.next

# Build outputs (rebuilt inside container)
**/dist
**/.turbo

# Database
**/*.db
**/*.db-journal
**/prisma/migrations

# Environment & secrets
.env
.env.*
!.env.example

# Git
.git
.gitignore

# IDE
.vscode
.idea
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Docker
docker-compose*.yml
Dockerfile*
.dockerignore

# Documentation
README.md
docs/
examples/

# Logs
**/logs
**/*.log
npm-debug.log*

# Testing
**/coverage
**/.nyc_output

# Misc
*.tgz
.cache
tmp/
