generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id                  String               @id @default(cuid())
  email               String               @unique
  displayName         String?
  avatar              String?
  passkeyId           String?
  passkeyPub          String?
  tier                Tier                 @default(FREE)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  apiKeys             ApiKey[]
  portfolios          Portfolio[]
  signals             SignalUsage[]
  rouaSignals         Signal[]
  sessions            Session[]
  accounts            Account[]
  exchangeCredentials ExchangeCredential[]
}

enum Tier {
  FREE
  PREMIUM
  INSTITUTIONAL
}

model ApiKey {
  id              String    @id @default(cuid())
  userId          String
  exchange        String
  encryptedKey    String
  encryptedSecret String
  permissions     String
  iv              String
  isActive        Boolean   @default(true)
  lastValidated   DateTime?
  createdAt       DateTime  @default(now())
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Portfolio {
  id          String           @id @default(cuid())
  userId      String
  name        String
  description String?
  totalValue  Float            @default(0)
  currency    String           @default("USD")
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  assets      PortfolioAsset[]

  @@index([userId])
}

model PortfolioAsset {
  id           String      @id @default(cuid())
  portfolioId  String
  symbol       String
  name         String
  quantity     Float
  avgPrice     Float
  currentPrice Float?
  exchange     String?
  assetType    AssetType
  addedAt      DateTime    @default(now())
  portfolio    Portfolio   @relation(fields: [portfolioId], references: [id], onDelete: Cascade)
}

enum AssetType {
  STOCK
  FOREX
  CRYPTO
  COMMODITY
  INDEX
}

// ── Signal System (Phase 4) ──
enum SignalAction {
  BUY
  SELL
  WAIT
}

enum SignalStatus {
  ACTIVE
  EXPIRED
  EXECUTED
  CANCELLED
}

model Signal {
  id          String       @id @default(cuid())
  userId      String
  pair        String
  action      SignalAction
  confidence  Int
  reason      String
  entryPrice  Float?
  stopLoss    Float?
  takeProfit  Float?
  status      SignalStatus @default(ACTIVE)
  expiresAt   DateTime
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([pair])
  @@index([status])
  @@index([expiresAt])
}

model SignalUsage {
  id         String   @id @default(cuid())
  userId     String
  signalType String
  asset      String
  confidence Float
  analysis   String
  signedHash String?
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  resource  String
  details   String?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([action])
  @@index([createdAt])
}

// ── News Article for RAG (Phase 4) ──
model NewsArticle {
  id          String   @id @default(cuid())
  source      String
  title       String
  content     String
  summary     String?
  url         String?
  sentiment   Float?
  entities    String?
  embedding   String?   // JSON-encoded 384-dim vector (upgrade to pgvector for Postgres)
  publishedAt DateTime
  createdAt   DateTime @default(now())

  @@index([source])
  @@index([publishedAt])
}

// ── Exchange Credential model (encrypted API keys) ──
model ExchangeCredential {
  id               String    @id @default(cuid())
  userId           String
  exchange         String
  label            String
  encryptedApiKey  String
  encryptedSecret  String
  iv               String
  authTag          String
  permissions      String    @default("read")
  isValid          Boolean   @default(true)
  lastValidatedAt  DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([exchange])
}

// ── WebAuthn Challenge store ──
model Challenge {
  id        String   @id @default(cuid())
  key       String   @unique
  challenge String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([key])
  @@index([expiresAt])
}

// ── OAuth Account model (NextAuth) ──
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
// Trading Engine Models
// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

enum OrderSide {
  BUY
  SELL
}

enum OrderType {
  MARKET
  LIMIT
}

enum OrderStatus {
  PENDING
  ACCEPTED
  PARTIALLY_FILLED
  FILLED
  CANCELLED
  REJECTED
}

enum OrderEventType {
  CREATED
  RISK_REJECTED
  SENT_TO_EXCHANGE
  FILLED
  CANCELLED
}

model Order {
  id                  String       @id @default(uuid())
  userId              String
  exchangeCredentialId String
  symbol              String
  side                OrderSide
  type                OrderType
  quantity            Decimal
  price               Decimal?
  stopLoss            Decimal?
  takeProfit          Decimal?
  status              OrderStatus  @default(PENDING)
  filledQuantity      Decimal      @default(0)
  averagePrice        Decimal?
  idempotencyKey      String       @unique
  clientOrderId       String?
  exchangeOrderId     String?
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  events              OrderEvent[]

  @@index([userId])
  @@index([symbol])
  @@index([status])
  @@index([exchangeCredentialId])
  @@index([createdAt])
}

model OrderEvent {
  id        String          @id @default(uuid())
  orderId   String
  order     Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  eventType OrderEventType
  payload   String?
  timestamp DateTime        @default(now())

  @@index([orderId])
  @@index([eventType])
  @@index([timestamp])
}

enum PositionStatus {
  OPEN
  CLOSED
  LIQUIDATED
}

model Position {
  id             String         @id @default(cuid())
  userId         String
  credentialId   String
  exchange       String
  symbol         String
  side           OrderSide
  status         PositionStatus @default(OPEN)
  quantity       Float
  entryPrice     Float
  currentPrice   Float?
  highestPrice   Float?
  lowestPrice    Float?
  stopLoss       Float?
  takeProfit     Float?
  unrealizedPnl  Float?
  realizedPnl    Float?
  openedAt       DateTime       @default(now())
  closedAt       DateTime?

  @@index([userId])
  @@index([symbol])
  @@index([status])
}

enum TradeType {
  ENTRY
  EXIT
  PARTIAL_EXIT
}

model Trade {
  id           String    @id @default(cuid())
  userId       String
  orderId      String?
  positionId   String?
  exchange     String
  symbol       String
  side         OrderSide
  type         TradeType
  quantity     Float
  price        Float
  fee          Float?
  feeCurrency  String?
  pnl          Float?
  executedAt   DateTime  @default(now())

  @@index([userId])
  @@index([symbol])
  @@index([executedAt])
}
